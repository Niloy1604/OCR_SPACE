OCRSPACE_API_KEY=your_api_key_here
CAMERA_INDEX=0
DETECTION_INTERVAL_SECONDS=2.0
MOTION_THRESHOLD=12.0
LANGUAGE_HINTS=en,hi,bn,gu,kn,ml,mr,ne,ur
ENABLE_LOCAL_OFFLINE_FALLBACK=True
HOST=0.0.0.0
PORT=8000
