GOOGLE_API_KEY=your_google_api_key_here

# TTS Engine Settings
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
GOOGLE_TTS_VOICE=Algieba
CHIRP3_BACKUP_VOICE=en-US-Chirp3-HD-Charon
